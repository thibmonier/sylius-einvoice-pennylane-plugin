parameters:
    level: max
    reportUnmatchedIgnoredErrors: false
    paths:
        - src
        - tests/Unit
        - tests/Integration

    excludePaths:
        # Test dependencies
        - 'tests/TestApplication/src/**.php'
        # Red phase of US-283: placeholders, replaced by the implementation in the next commit (this entry goes with it).
        - src/Api/PennylaneClient.php
        - src/Transmission/PennylaneInvoiceTransmitter.php

    ignoreErrors:
        -
            identifier: missingType.iterableValue

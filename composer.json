{
    "name": "tmonier/sylius-einvoice-pennylane-plugin",
    "type": "sylius-plugin",
    "description": "Pennylane adapter for the Sylius 2 e-invoice transmission plugin: finds or creates the customer, then imports the Factur-X invoice into Pennylane through the Company API v2",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "einvoice",
        "e-invoicing",
        "factur-x",
        "pennylane",
        "facture-electronique",
        "pa"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "sylius/sylius": "^2.2.9 || ^2.3",
        "symfony/http-client": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-client-contracts": "^3.0",
        "symfony/mime": "^6.4 || ^7.4 || ^8.0",
        "tmonier/sylius-einvoice-transmission-plugin": "^0.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^10.5",
        "rector/rector": "^2.0",
        "sylius-labs/coding-standard": "^4.4",
        "sylius/test-application": "^2.0.0@alpha",
        "symfony/browser-kit": "^6.4 || ^7.4 || ^8.0",
        "symfony/css-selector": "^6.4 || ^7.4 || ^8.0",
        "symfony/debug-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/dom-crawler": "^6.4 || ^7.4 || ^8.0",
        "symfony/dotenv": "^6.4 || ^7.4 || ^8.0",
        "symfony/intl": "^6.4 || ^7.4 || ^8.0",
        "symfony/runtime": "^6.4 || ^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/webpack-encore-bundle": "^2.2"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "policy": {
            "advisories": {
                "block": true,
                "audit": "fail"
            },
            "abandoned": {
                "block": false,
                "audit": "report"
            },
            "malware": {
                "block": true,
                "block-scope": "all",
                "audit": "fail"
            }
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        },
        "symfony": {
            "require": "^7.4"
        },
        "public-dir": "vendor/sylius/test-application/public"
    },
    "autoload": {
        "psr-4": {
            "Tmonier\\SyliusEinvoicePennylanePlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Tmonier\\SyliusEinvoicePennylanePlugin\\": [
                "tests/",
                "tests/TestApplication/src/"
            ]
        }
    },
    "scripts": {
        "database-reset": [
            "vendor/bin/console doctrine:database:drop --force --if-exists",
            "vendor/bin/console doctrine:database:create",
            "vendor/bin/console doctrine:migration:migrate -n",
            "vendor/bin/console sylius:fixtures:load -n"
        ],
        "frontend-clear": [
            "cd vendor/sylius/test-application && yarn install && yarn build",
            "vendor/bin/console assets:install"
        ],
        "test-app-init": [
            "@database-reset",
            "@frontend-clear"
        ]
    },
    "authors": [
        {
            "name": "Thibaut Monier"
        }
    ]
}
